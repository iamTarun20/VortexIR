  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pdfjs-dist": "6.2.108",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "@vitejs/plugin-react": "^5.0.4"
  }
