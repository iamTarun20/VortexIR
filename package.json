{
  "name": "vortexir",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "bash scripts/build-wasm.sh",
